+static bool ec_eeprom_config_is_valid(const eeprom_ec_config_t* cfg) {
+    if (cfg->actuation_mode > 1) {
+        return false;
+    }
+
+    if (cfg->mode_0_actuation_threshold > 1023) {
+        return false;
+    }
+
+    if (cfg->mode_0_release_threshold > cfg->mode_0_actuation_threshold) {
+        return false;
+    }
+
+    if (cfg->mode_1_initial_deadzone_offset > 1023) {
+        return false;
+    }
+
+    if (cfg->mode_1_actuation_offset == 0 || cfg->mode_1_release_offset == 0) {
+        return false;
+    }
+
+    for (uint8_t row = 0; row < MATRIX_ROWS; row++) {
+        for (uint8_t col = 0; col < MATRIX_COLS; col++) {
+            uint16_t bottoming = cfg->bottoming_reading[row][col];
+            if (bottoming == 0 || bottoming > 1023) {
+                return false;
+            }
+        }
+    }
+
+    return true;
+}
+
+static bool ec_apply_minimum_thresholds(eeprom_ec_config_t* cfg) {
+    bool changed = false;
+
+    if (cfg->mode_0_actuation_threshold < DEFAULT_MODE_0_ACTUATION_LEVEL) {
+        cfg->mode_0_actuation_threshold = DEFAULT_MODE_0_ACTUATION_LEVEL;
+        changed                         = true;
+    }
+
+    if (cfg->mode_0_release_threshold < DEFAULT_MODE_0_RELEASE_LEVEL) {
+        cfg->mode_0_release_threshold = DEFAULT_MODE_0_RELEASE_LEVEL;
+        changed                       = true;
+    }
+
+    if (cfg->mode_0_release_threshold > cfg->mode_0_actuation_threshold) {
+        cfg->mode_0_release_threshold = cfg->mode_0_actuation_threshold;
+        changed                       = true;
+    }
+
+    if (cfg->mode_1_initial_deadzone_offset < DEFAULT_MODE_1_INITIAL_DEADZONE_OFFSET) {
+        cfg->mode_1_initial_deadzone_offset = DEFAULT_MODE_1_INITIAL_DEADZONE_OFFSET;
+        changed                             = true;
+    }
+
+    if (cfg->mode_1_actuation_offset < DEFAULT_MODE_1_ACTUATION_OFFSET) {
+        cfg->mode_1_actuation_offset = DEFAULT_MODE_1_ACTUATION_OFFSET;
+        changed                      = true;
+    }
+
+    if (cfg->mode_1_release_offset < DEFAULT_MODE_1_RELEASE_OFFSET) {
+        cfg->mode_1_release_offset = DEFAULT_MODE_1_RELEASE_OFFSET;
+        changed                    = true;
+    }
+
+    return changed;
+}
