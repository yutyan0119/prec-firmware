 void eeconfig_init_kb(void) {
     // Default values
     eeprom_ec_config.actuation_mode                 = DEFAULT_ACTUATION_MODE;
@@ -46,6 +116,18 @@ void keyboard_post_init_kb(void) {
     // Read custom menu variables from memory
     eeconfig_read_kb_datablock(&eeprom_ec_config);
 
+    // Stale/invalid EEPROM data can happen when switching between debug/full firmware.
+    // Reinitialize to safe defaults if values are out of expected range.
+    if (!ec_eeprom_config_is_valid(&eeprom_ec_config)) {
+        eeconfig_init_kb();
+        eeconfig_read_kb_datablock(&eeprom_ec_config);
+    }
+
+    // Keep existing users from staying on overly sensitive legacy defaults.
+    if (ec_apply_minimum_thresholds(&eeprom_ec_config)) {
+        eeconfig_update_kb_datablock(&eeprom_ec_config);
+    }
+
     // Set runtime values to EEPROM values
     ec_config.actuation_mode                 = eeprom_ec_config.actuation_mode;
     ec_config.mode_0_actuation_threshold     = eeprom_ec_config.mode_0_actuation_threshold;
